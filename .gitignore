# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.audit_deps/
outputs/independent_audit/baseline/snapshot/

# Tests and coverage
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
*_api_key.txt
*_apikey.txt

# Editors and local tools
.vscode/
.idea/
.claude/

# Operating systems
Thumbs.db
.DS_Store

# Local scratch files
tmp/
temp/
*.tmp
*.log

# Archives
*.zip
*.7z
*.tar
*.tar.gz

# 원자료 (용량/배포제한, 로컬 보관)
data/raw/**

# 외부 수집물의 '수집 증빙'은 공유한다: 안내문·출처/해시 metadata·수집 로그.
# 원본 CSV 자체는 위 원칙대로 로컬 보관이다.
!data/raw/**/
!data/raw/**/README.md
!data/raw/**/_collection*.json
!data/raw/**/_metadata/
!data/raw/**/_metadata/*.json

# 재실행 시 자동 보관되는 이전 가공본
data/processed/kicox/_previous/**

# 보관 자료
archive/**
!archive/*/.gitkeep

# 빌드 로그 (산출 CSV/JSON 은 커밋)
logs/**/*.log

# 로컬 전용 조사메모
private/

# 모형 실행별 산출물 보관(로컬). canonical 산출물과 outputs/current_run_manifest.json만 공유
outputs/runs/

# Final verification recreates these local intermediates; canonical results remain shared.
outputs/final_model/06_report_assets/qa/jupyter/
outputs/final_model/06_report_assets/qa/jupyter_runtime/
logs/validation/final_qa/*tests.xml

# 점검 업무 기록 로컬 DB(사용자가 화면에서 만든 기록만 저장)
app_state/
