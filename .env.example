# 이 파일을 복사해 저장소 루트에 `.env.txt`(또는 `.env`)로 저장한 뒤 값을 채웁니다.
# `.env.txt`·`.env`는 .gitignore 대상입니다. 실제 키를 이 파일(.env.example)에 넣지 마세요.
# 키가 없어도 앱은 실행됩니다. 이 경우 AI 문장 생성·기업마당 최신 공고만 '미설정'으로 표시됩니다.

# ---- 행정 AI 비서: Gemini 문장 생성(선택)
COPILOT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# COPILOT_LLM_MODEL=              # 비우면 기본 모델
# COPILOT_LLM_COMPOSE=off         # 기본 켜짐. off면 등록 진단 문장을 그대로 표시

# ---- 기업마당(BIZINFO) 최신 공고(선택)
COPILOT_OFFICIAL_APIS=bizinfo
BIZINFO_API_KEY=

# ---- 외부 웹 검색 grounding(기본 꺼짐 — 켜지 않는 것을 권장)
COPILOT_WEB_PROVIDER=off

# ---- 업무 기록 DB(선택). 비우면 app_state/workflow.db(로컬 SQLite, gitignore)
# DSS_DATABASE_URL=

# ---- 외부자료 수집기용 키(앱 실행에는 필요 없음, src/evidence/collection/ 수집 시에만)
# KOSIS_API_KEY=
# DATA_GO_KR_SERVICE_KEY=
# KEPCO_API_KEY=
# ECOS_API_KEY=
# WORK24_COMMON_CODE_API_KEY=
# WORK24_JOB_API_KEY=
# KICOX_FACTORY_API_KEY=
